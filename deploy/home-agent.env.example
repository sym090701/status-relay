HOME_RELAY_URL=https://replace-with-private-agent-endpoint
HOME_AGENT_TOKEN=replace_with_distinct_agent_token_at_least_32_chars
HOME_AGENT_DB=/var/lib/status-relay-home-agent/journal.sqlite3
HOME_QUOTA_URL=http://127.0.0.1:8765
HOME_QUOTA_TOKEN_FILE=/etc/status-relay-home/quota-token
HOME_POLL_SECONDS=15
HOME_ENABLE_PREHEAT=0
# HOME_ALLOW_PRIVATE_HTTP=1
